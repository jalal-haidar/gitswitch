{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the trusted local main window",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:allow-check",
    "updater:allow-download-and-install",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://git-scm.com/downloads" }]
    }
  ]
}
